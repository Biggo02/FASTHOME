# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://fasthome:change-me@localhost:5432/fasthome?schema=public"

# Application
NEXT_PUBLIC_APP_NAME="FASTHOME"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security - use a long random value in production
SESSION_SECRET="change-this-to-a-long-random-secret"

# Comma-separated User IDs allowed to administer FASTHOME
FASTHOME_ADMIN_USER_IDS=""
